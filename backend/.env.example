# Credenciales para el entorno de desarrollo local
# Copiar este archivo a .env y ajustar si cambian los valores

# PostgreSQL — Sucursal Occidente (Inventario)
PG_HOST=localhost
PG_PORT=5432
PG_DB=inventario_db
PG_USER=admin_inventario
PG_PASSWORD=PostgresPass123

# SQL Server — Sucursal Capital (Ventas)
SS_HOST=localhost
SS_PORT=1433
SS_DB=ventas_db
SS_USER=sa
SS_PASSWORD=SqlServerPass123!

# Oracle — Sede Central (Administrativo)
ORA_HOST=localhost
ORA_PORT=1521
ORA_SERVICE=XEPDB1
ORA_USER=admin_central
ORA_PASSWORD=AdminPass123
